{
  "kind": "Dashboard",
  "metadata": {
    "name": "traffic",
    "project": "inventory"
  },
  "spec": {
    "display": {
      "name": "Traffic"
    },
    "duration": "6h",
    "panels": {
      "rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests per second"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right",
                "mode": "table",
                "values": [
                  "last",
                  "max"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "requests/sec",
                  "decimalPlaces": 1
                },
                "min": 0
              },
              "visual": {
                "display": "line",
                "lineWidth": 2,
                "areaOpacity": 0.2
              },
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "green",
                "steps": [
                  {
                    "value": 10,
                    "color": "red"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (service_name) (rate(app_requests_total[5m]))",
                    "seriesNameFormat": "{{service_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "by-env": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests per second by environment"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (deployment_environment) (rate(app_requests_total[5m]))",
                    "seriesNameFormat": "{{deployment_environment}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/rate"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Details",
            "collapse": {
              "open": false
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/by-env"
              }
            }
          ]
        }
      }
    ],
    "refreshInterval": "30s"
  }
}