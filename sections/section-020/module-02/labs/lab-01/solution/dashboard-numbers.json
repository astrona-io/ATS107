{
  "kind": "Dashboard",
  "metadata": {
    "name": "numbers",
    "project": "inventory"
  },
  "spec": {
    "display": {
      "name": "Numbers"
    },
    "duration": "1h",
    "variables": [],
    "panels": {
      "total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total requests per second"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "requests/sec",
                "decimalPlaces": 2
              },
              "sparkline": {}
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(app_requests_total[5m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "share": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Share of checkout"
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last",
              "format": {
                "unit": "percent-decimal",
                "decimalPlaces": 1
              },
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "green",
                "steps": [
                  {
                    "value": 0.6,
                    "color": "orange"
                  },
                  {
                    "value": 0.8,
                    "color": "red"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(rate(app_requests_total{service_name=\"checkout\"}[5m])) / sum(rate(app_requests_total[5m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "by-service": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests per second by service"
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last",
              "sort": "desc",
              "mode": "value",
              "format": {
                "unit": "requests/sec",
                "decimalPlaces": 2
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (service_name) (rate(app_requests_total[5m]))",
                    "seriesNameFormat": "{{service_name}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/total"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 8,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/share"
              }
            },
            {
              "x": 0,
              "y": 6,
              "width": 16,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/by-service"
              }
            }
          ]
        }
      }
    ]
  }
}