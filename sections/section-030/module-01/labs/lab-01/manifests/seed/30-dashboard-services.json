{
  "kind": "Dashboard",
  "metadata": {
    "name": "services",
    "project": "inventory"
  },
  "spec": {
    "display": {
      "name": "Services"
    },
    "duration": "1h",
    "variables": [],
    "panels": {
      "requests": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request rate by service"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {}
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (service_name) (rate(app_requests_total{service_name=\"checkout\"}[5m]))"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/requests"
              }
            }
          ]
        }
      }
    ]
  }
}
